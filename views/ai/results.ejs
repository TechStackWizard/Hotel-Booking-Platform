<% layout('layouts/boilerplate') %>

    <div class="container mt-5">
        <h2 class="text-center mb-4">AI Recommended Hotels</h2>

        <% if(listings.length===0) { %>
            <div class="text-center text-muted">
                <p class="mb-3">No AI recommendations found. Please try again later.</p>
                <a href="/ai/recommend" class="btn btn-outline-dark">
                    Get New Recommendations
                </a>
            </div>
            <%} %>

                <% listings.forEach(listing=> { %>
                    <div class="card mb-4 shadow-sm ">
                        <div class="row g-4">

                            <!-- LEFT IMAGE -->
                            <div class="col-md-4">
                                <img src="<%= listing.image.url %>" class="img-fluid rounded-start w-100"
                                    style="height: 100%; object-fit: cover;" alt="hotel">
                            </div>

                            <!-- RIGHT DETAILS -->
                            <div class="col-md-8">
                                <div class="card-body d-flex flex-column h-100 pb-2">

                                    <!-- Badge -->
                                    <span class="badge align-self-start mb-2 px-3 py-2 text-white fw-semibold"
                                        style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 20px;">
                                        🤖 AI Recommended
                                    </span>

                                    <!-- Title -->
                                    <h5 class="card-title mb-2">
                                        <%= listing.title %>
                                    </h5>

                                    <!-- Location -->
                                    <p class="mb-1 text-muted">
                                        📍 <%= listing.location %>, <%= listing.country %>
                                    </p>

                                    <!-- Price -->
                                    <p class="mb-2 fw-semibold">
                                        💰 ₹<%= listing.price %> / night
                                    </p>

                                    <!-- Reason -->
                                    <p class="mb-2">
                                        🤖 <strong>Why recommended:</strong><br>
                                        <%= listing.aiReason %>
                                    </p>

                                    <!-- Button -->
                                    <a href="/listings/<%= listing._id %>" class="btn btn-dark align-self-start">
                                        View Listing
                                    </a>

                                </div>
                            </div>

                        </div>
                    </div>

                    <% }) %>
    </div>