<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HevenlyGo</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/starability.css">
    <style>
        /* Floating button container */
        .ai-bot-button {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 1000;
        }

        .ai-bot-button a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #11998e, #38ef7d);

            color: white;
            font-size: 28px;
            border-radius: 50%;
            text-decoration: none;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
        }

        /* Button styling */
        .ai-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            background: black;
            color: white;
            font-size: 28px;
            border-radius: 50%;
            text-decoration: none;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;

            /* Floating animation */
            animation: float 2.5s ease-in-out infinite;
        }

        /* Floating up-down */
        @keyframes float {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-8px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        /* Glow pulse */
        .ai-btn::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.2);
            animation: pulse 2s infinite;
            z-index: -1;
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
                opacity: 0.6;
            }

            70% {
                transform: scale(1.4);
                opacity: 0;
            }

            100% {
                opacity: 0;
            }
        }

        /* Hover effect */
        .ai-btn:hover {
            transform: scale(1.15);
            background: #333;
        }

        /* Tooltip */
        .ai-tooltip {
            position: absolute;
            right: 75px;
            background: black;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            opacity: 0;
            transform: translateX(10px);
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        /* Tooltip show */
        .ai-bot-button:hover .ai-tooltip {
            opacity: 1;
            transform: translateX(0);
        }

        /* Click ripple effect */
        .ai-btn:active {
            transform: scale(0.95);
        }

        .ai-btn::after {
            content: "";
            position: absolute;
            top: 5px;
            right: 5px;
            width: 10px;
            height: 10px;
            background: limegreen;
            border-radius: 50%;
            animation: blink 1.5s infinite;
        }

        @keyframes blink {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.2;
            }
        }
    </style>
</head>
<div class="ai-bot-button">
    <a href="/ai/recommend" title="Find Best Hotel for Me" class="ai-btn">
        🤖
        <span class="ai-tooltip">Ask AI for Best Hotel</span>
    </a>
</div>

<body class="d-flex flex-column min-vh-100">
    <%- include("../includes/navbar.ejs") %>
        <main class="container ">
            <%- include("../includes/flash.ejs") %>
                <%- body %>
        </main>
        <%- include("../includes/footer.ejs") %>

            <script src="/js/script.js"></script>
</body>

</html>